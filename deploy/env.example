# Copy to .env and fill in. chmod 600 .env. NEVER commit this file.
HYPERLIQUID_ACCOUNT_ADDRESS=0x你的主钱包地址
HYPERLIQUID_PRIVATE_KEY=0x你的API钱包私钥

# Optional but strongly recommended: push alerts + daily summaries
HYPERBOT_TELEGRAM_TOKEN=
HYPERBOT_TELEGRAM_CHAT_ID=
# or use a generic webhook instead of Telegram:
# HYPERBOT_WEBHOOK_URL=https://example.com/hook

# Force a mode regardless of config.json (paper | testnet | mainnet)
# HYPERBOT_MODE=mainnet
